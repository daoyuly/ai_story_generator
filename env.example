# OpenAI API配置
OPENAI_API_KEY=your_openai_api_key_here

# 数据库配置
DATABASE_PATH=data/story_generator.db

# 模型配置
DEFAULT_MODEL=gpt-5
TEMPERATURE=0.7

# 主编
EDITOR_AGENT_MODEL=gpt-5
EDITOR_AGENT_FLASH_MODEL=gpt-3.5
# 大纲创作专家
OUTLINE_AGENT_MODEL=gpt-5
OUTLINE_AGENT_FLASH_MODEL=gpt-3.5
# 小说创作专家
WRITER_AGENT_MODEL=gpt-4o
WRITER_AGENT_FLASH_MODEL=gpt-3.5
# 资深读者
READER_AGENT_MODEL=gpt-4o-mini
READER_AGENT_FLASH_MODEL=gpt-3.5

# 搜索配置
SEARCH_MAX_RESULTS=5
